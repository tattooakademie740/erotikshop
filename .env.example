# Kopieren nach .env.local und ausfüllen. Niemals echte Secrets committen.
DATABASE_URL=postgres://shop@localhost:5433/shop

# Öffentliche Basis-URL (für Sitemap, Canonical-Links). Produktion: https://lustviora.de
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Zahlungsanbieter (noch nicht angebunden)
# PAYMENT_PROVIDER=
# PAYMENT_SECRET_KEY=

# Lieferanten-Zugangsdaten: pro Lieferant eine Variable,
# deren NAME in suppliers.credentials_env steht.
# SUPPLIER_EXAMPLE_FEED_TOKEN=

# Mindestens 32 Zeichen, z. B. mit: openssl rand -hex 32
REVALIDATE_SECRET=

# E-Mail-Versand (leer = Mails werden nur protokolliert, nicht verschickt)
# SMTP_URL=smtps://benutzer:passwort@smtp.example.com:465
# MAIL_FROM=Lustviora <bestellung@lustviora.de>

# Sendungsnummern-Webhook, mindestens 32 Zeichen
TRACKING_WEBHOOK_SECRET=
