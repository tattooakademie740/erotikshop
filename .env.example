# Kopieren nach .env.local und ausfüllen. Niemals echte Secrets committen.
DATABASE_URL=postgres://shop@localhost:5433/shop

# Öffentliche Basis-URL (für Sitemap, Canonical-Links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Zahlungsanbieter (noch nicht angebunden)
# PAYMENT_PROVIDER=
# PAYMENT_SECRET_KEY=

# Lieferanten-Zugangsdaten: pro Lieferant eine Variable,
# deren NAME in suppliers.credentials_env steht.
# SUPPLIER_EXAMPLE_FEED_TOKEN=
